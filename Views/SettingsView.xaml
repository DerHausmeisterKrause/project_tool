<UserControl x:Class="TaskTool.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}">
    <Grid Background="{StaticResource BgBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Einstellungen" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <CheckBox Content="Outlook Sync aktiv" IsChecked="{Binding OutlookSyncEnabled}" Margin="0,0,0,8"/>
                        <CheckBox Content="Outlook Kalender anzeigen" IsChecked="{Binding OutlookCalendarEnabled}" Margin="0,0,0,8"/>
                        <CheckBox Content="Konflikte warnen" IsChecked="{Binding OutlookConflictWarningsEnabled}" Margin="0,0,0,8"/>
                        <CheckBox Content="Teams-Button anzeigen" IsChecked="{Binding OutlookTeamsButtonEnabled}" Margin="0,0,0,8"/>
                        <CheckBox Content="Ganztagstermine als Tagesmarker interpretieren" IsChecked="{Binding OutlookInterpretAllDayAsMarkers}" Margin="0,0,0,8"/>
                        <CheckBox Content="Wochenende anzeigen" IsChecked="{Binding ShowWeekendInWeekView}" Margin="0,0,0,8"/>
                        <TextBlock Text="Outlook Kalender Sync-Modus" Foreground="{StaticResource MutedTextBrush}"/>
                        <ComboBox Width="220" Style="{StaticResource DarkComboBoxStyle}" ItemsSource="{Binding OutlookSyncModes}" SelectedItem="{Binding OutlookCalendarSyncMode}" Margin="0,0,0,8"/>
                        <TextBlock Text="Sync Intervall (Minuten)" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBox Text="{Binding OutlookCalendarSyncIntervalMinutes}" Width="120" Margin="0,0,0,8"/>
                        <TextBlock Text="Zeitfenster Rückblick (Tage)" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBox Text="{Binding OutlookCalendarRangePastDays}" Width="120" Margin="0,0,0,8"/>
                        <TextBlock Text="Zeitfenster Vorschau (Tage)" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBox Text="{Binding OutlookCalendarRangeFutureDays}" Width="120" Margin="0,0,0,8"/>
                        <Button Content="Outlook Kalender jetzt synchronisieren" Width="260" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,8" Command="{Binding RefreshOutlookCalendarCommand}"/>
                        <Button Content="Outlook Verbindung testen" Width="220" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,12" Command="{Binding TestOutlookConnectionCommand}"/>
                        <CheckBox Content="Dynamic Island aktiv" IsChecked="{Binding DynamicIslandEnabled}" Margin="0,0,0,12"/>
                        <TextBlock Text="Outlook Kategorie" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBox Text="{Binding OutlookCategoryName}" Width="260"/>
                        <TextBlock Text="Reminder Vorlauf Minuten" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBox Text="{Binding ReminderLeadMinutes}" Width="120"/>
                        <Button Content="Reminder testen" Width="220" Margin="0,8,0,0" Command="{Binding TestReminderCommand}"/>
                        <TextBlock Text="Datum/Zeit Format" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBox Text="{Binding DateTimeFormat}" Width="220"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Znuny / OTRS Ticketsystem" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock Text="Server URL / Webseite" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBox Text="{Binding TicketSystemWebUrl, UpdateSourceTrigger=PropertyChanged}" Width="560" ToolTip="Beispiel: https://SERVER/otrs/index.pl"/>
                        <TextBlock Text="API URL (GenericTicketConnectorREST)" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBox Text="{Binding TicketSystemApiUrl, UpdateSourceTrigger=PropertyChanged}" Width="560" ToolTip="https://SERVER/nph-genericinterface.pl/Webservice/GenericTicketConnectorREST"/>
                        <TextBlock Text="Beispiel: https://SERVER/nph-genericinterface.pl/Webservice/GenericTicketConnectorREST" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Text="Benutzername" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBox Text="{Binding TicketSystemUsername, UpdateSourceTrigger=PropertyChanged}" Width="320"/>
                        <TextBlock Text="Passwort (verschlüsselt gespeichert)" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBox Text="{Binding TicketSystemPassword, UpdateSourceTrigger=PropertyChanged}" Width="320"/>
                        <TextBlock Text="Znuny Agenten-ID (Fallback, falls SessionGet keine UserID liefert)" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBox Text="{Binding TicketSystemAgentId, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        <TextBlock Text="Synchronisationsintervall (Minuten)" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBox Text="{Binding TicketSystemSyncIntervalMinutes, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        <CheckBox Content="Nur offene Tickets synchronisieren" IsChecked="{Binding TicketSystemOnlyOpenTickets}" Margin="0,8,0,4"/>
                        <CheckBox Content="Geschlossene Tickets anzeigen / übernehmen" IsChecked="{Binding TicketSystemShowClosedTickets}" Margin="0,0,0,4"/>
                        <CheckBox Content="Tickets berücksichtigen, bei denen ich Owner bin" IsChecked="{Binding TicketSystemIncludeOwner}" Margin="0,0,0,4"/>
                        <CheckBox Content="Tickets berücksichtigen, bei denen ich Responsible bin" IsChecked="{Binding TicketSystemIncludeResponsible}" Margin="0,0,0,8"/>
                        <TextBlock Text="Der Sync nutzt SessionCreate, SessionGet, TicketSearch mit OwnerIDs/ResponsibleIDs und TicketGet. API-Tokens werden für diesen Connector nicht verwendet. Die Agenten-ID wird nur benötigt, wenn SessionGet keine UserID zurückliefert."
                                   Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <Button Content="Znuny Tickets jetzt synchronisieren" Width="300" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ImportTicketSystemTasksCommand}"/>
                        <TextBlock Text="{Binding TicketSystemStatus}" Foreground="#FBBF24" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Sollstunden pro Wochentag (Minuten)" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Montag"/><TextBox Grid.Row="0" Grid.Column="1" Text="{Binding MondayTargetMinutes}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Dienstag"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TuesdayTargetMinutes}"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Mittwoch"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding WednesdayTargetMinutes}"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Donnerstag"/><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ThursdayTargetMinutes}"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Freitag"/><TextBox Grid.Row="4" Grid.Column="1" Text="{Binding FridayTargetMinutes}"/>
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Samstag"/><TextBox Grid.Row="5" Grid.Column="1" Text="{Binding SaturdayTargetMinutes}"/>
                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Sonntag"/><TextBox Grid.Row="6" Grid.Column="1" Text="{Binding SundayTargetMinutes}"/>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
