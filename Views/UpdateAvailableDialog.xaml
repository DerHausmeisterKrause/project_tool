<Window x:Class="TaskTool.Views.UpdateAvailableDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Neue Plenaro-Version verfügbar" Width="520" SizeToContent="Height"
        MaxHeight="720" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False" Background="{StaticResource BgBrush}">
    <Border Style="{StaticResource CardStyle}" Margin="18" Padding="20">
        <StackPanel>
            <TextBlock Text="Neue Version verfügbar" FontSize="23" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding IntroText}" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,18"/>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource SurfaceAltBrush}" CornerRadius="8" Padding="12" Margin="0,0,6,0">
                    <StackPanel><TextBlock Text="Installiert" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Text="{Binding InstalledVersion}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#172554" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="6,0,0,0">
                    <StackPanel><TextBlock Text="Neue Version" Foreground="{StaticResource MutedTextBrush}"/><TextBlock Text="{Binding AvailableVersion}" FontSize="18" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
                </Border>
            </Grid>

            <StackPanel Visibility="{Binding HasReleaseNotes, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="Was ist neu?" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <Border Background="{StaticResource SurfaceAltBrush}" CornerRadius="6" Padding="10" Margin="0,0,0,14">
                    <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding ReleaseNotes}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
                    </ScrollViewer>
                </Border>
            </StackPanel>

            <Border Background="#422006" BorderBrush="#B45309" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,18">
                <TextBlock Text="Das Update wird heruntergeladen. Anschließend wird Plenaro kurz geschlossen und automatisch neu gestartet."
                           TextWrapping="Wrap" Foreground="#FDE68A"/>
            </Border>
            <TextBlock Text="Möchtest du das Update jetzt installieren?" FontWeight="SemiBold" Margin="0,0,0,14"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Button Grid.Column="1" Content="Später" Width="110" Style="{StaticResource SecondaryButtonStyle}" Click="Defer_Click" IsCancel="True"/>
                <Button Grid.Column="2" Content="Jetzt installieren" Width="155" Click="Install_Click" IsDefault="True"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
