<UserControl x:Class="TaskTool.Views.TaskDetailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="{Binding SelectedTask, Converter={StaticResource NullToVisibilityConverter}}"
             Background="{StaticResource BgBrush}"
             SizeChanged="TaskDetailPanel_SizeChanged">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="Transparent">
        <StackPanel>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Task Details" FontSize="13" Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBlock Text="{Binding SelectedTask.Title}" FontSize="24" FontWeight="Bold" Margin="0,4,0,10" TextWrapping="Wrap"/>

                    <StackPanel Visibility="{Binding ShowLocalTaskDescription, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Beschreibung" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding SelectedTask.Description, UpdateSourceTrigger=PropertyChanged}" MinHeight="220" MaxHeight="380" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding HasZnunyTicket, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="Nachrichten aktualisieren" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding RefreshTicketArticlesCommand}" Margin="8,0,0,0"/>
                            <TextBlock Text="Ticket-Nachrichten" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="Nachricht" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,3"/>
                        <ComboBox Style="{StaticResource DarkComboBoxStyle}" ItemsSource="{Binding TicketArticles}"
                                  SelectedItem="{Binding SelectedTicketArticle}" DisplayMemberPath="DisplayText" HorizontalAlignment="Stretch"/>
                        <TextBlock Text="{Binding TicketConversationMessage}" Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>

                        <StackPanel Visibility="{Binding HasSelectedTicketArticle, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Visibility="{Binding ShowTicketArticleView, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Margin="0,10,0,2" TextWrapping="Wrap">
                                    <Run Text="Von: " FontWeight="SemiBold"/><Run Text="{Binding SelectedTicketArticle.FromDisplay}"/>
                                </TextBlock>
                                <TextBlock Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap">
                                    <Run Text="{Binding SelectedTicketArticle.CreatedDisplay}"/><Run Text=" · "/><Run Text="{Binding SelectedTicketArticle.TypeText}"/>
                                </TextBlock>
                                <TextBox Text="{Binding SelectedTicketArticle.Body}" IsReadOnly="True" MinHeight="220" MaxHeight="380"
                                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"/>
                                <Button Content="Antworten" HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding BeginTicketReplyCommand}"/>
                            </StackPanel>

                            <StackPanel Visibility="{Binding IsTicketReplyMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="Antwort schreiben" FontWeight="SemiBold" FontSize="16" Margin="0,10,0,6"/>
                                <TextBlock TextWrapping="Wrap"><Run Text="An: " FontWeight="SemiBold"/><Run Text="{Binding TicketReplyRecipient}"/></TextBlock>
                                <TextBox Text="{Binding TicketReplyText, UpdateSourceTrigger=PropertyChanged}" MinHeight="220" MaxHeight="380"
                                         MaxLength="10000" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0"/>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="Antwort senden" Command="{Binding SendTicketReplyCommand}"/>
                                    <Button Content="Abbrechen" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding CancelTicketReplyCommand}"/>
                                </WrapPanel>
                            </StackPanel>
                        </StackPanel>

                        <Expander Header="Lokale Task-Beschreibung" Margin="0,12,0,0"
                                  Visibility="{Binding HasPlenaroLocalOrigin, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Margin="0,8,0,0">
                                <TextBox Text="{Binding SelectedTask.Description, UpdateSourceTrigger=PropertyChanged}" MinHeight="140" MaxHeight="300"
                                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                                <Button Content="Speichern" Width="94" HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding SaveCommand}"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <TextBlock Text="Ticket URL" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,8,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding SelectedTask.TicketUrl, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="1" Content="Ticket öffnen" Width="110" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"
                                Command="{Binding OpenTicketUrlCommand}" CommandParameter="{Binding SelectedTask.TicketUrl}"/>
                    </Grid>

                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="Speichern" Width="94" Command="{Binding SaveCommand}"
                                Visibility="{Binding ShowLocalTaskDescription, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <Button Content="Erledigt" Width="94" Style="{StaticResource SuccessButtonStyle}" Command="{Binding DoneCommand}"/>
                        <Button Content="Zurück zu Aktuell" Width="120" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ReopenCommand}"/>
                        <Button Content="Als Ticket erstellen" Width="150" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CreateTicketFromLocalTaskCommand}"
                                IsEnabled="{Binding CanCreateTicketFromSelectedTask}"
                                Visibility="{Binding ShowCreateTicketFromSelectedTask, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <Grid x:Name="BookingLayoutGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="BookingTimerColumn" Width="1.2*" MinWidth="0"/>
                        <ColumnDefinition x:Name="BookingHistoryColumn" Width="*" MinWidth="0"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="BookingTimerPanel" Grid.Column="0" Grid.Row="0" Margin="0,0,12,0">
                        <TextBlock Text="Timer / Buchung" FontSize="13" Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBlock Text="{Binding TimerDisplay}" FontSize="38" FontWeight="Bold" Margin="0,6,0,4" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding UnbookedTicketTimeText}" FontWeight="SemiBold" Foreground="#FBBF24" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <WrapPanel HorizontalAlignment="Center">
                            <Button Content="Start" Width="82" Command="{Binding StartTimerCommand}"/>
                            <Button Content="Stop" Width="82" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding StopTimerCommand}"/>
                        </WrapPanel>
                        <WrapPanel HorizontalAlignment="Center">
                            <Button Content="+15" Width="72" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding Add15Command}"/>
                            <Button Content="+30" Width="72" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding Add30Command}"/>
                            <Button Content="+1h" Width="72" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding Add60Command}"/>
                        </WrapPanel>
                        <WrapPanel HorizontalAlignment="Center">
                            <Button Content="-15" Width="72" Style="{StaticResource DangerButtonStyle}" Command="{Binding Subtract15Command}"/>
                            <Button Content="-30" Width="72" Style="{StaticResource DangerButtonStyle}" Command="{Binding Subtract30Command}"/>
                            <Button Content="-1h" Width="72" Style="{StaticResource DangerButtonStyle}" Command="{Binding Subtract60Command}"/>
                        </WrapPanel>
                        <StackPanel Visibility="{Binding HasZnunyTicket, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Kostenstelle" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,2"/>
                            <ComboBox Style="{StaticResource DarkComboBoxStyle}" ItemsSource="{Binding CostCenterOptions}" SelectedItem="{Binding SelectedCostCenter}" DisplayMemberPath="DisplayText"/>
                            <TextBlock Text="Auftrag" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,2"/>
                            <ComboBox Style="{StaticResource DarkComboBoxStyle}" ItemsSource="{Binding OrderOptions}" SelectedItem="{Binding SelectedOrder}" DisplayMemberPath="DisplayText"/>
                            <TextBlock Text="Notiz zur Buchung (optional)" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,2"/>
                            <TextBox Text="{Binding TicketBookingNote, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" MaxHeight="100" MaxLength="2000"
                                     VerticalScrollBarVisibility="Auto"/>
                            <TextBlock Text="{Binding TicketBookingInformation}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <Button Content="Kostenstellen/Aufträge neu laden" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                                    Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RefreshTicketFieldOptionsCommand}"/>
                            <Button Content="Im Ticketsystem buchen" Margin="0,10,0,0" HorizontalAlignment="Stretch"
                                    Command="{Binding BookTimeInTicketSystemCommand}"/>
                        </StackPanel>
                    </StackPanel>

                    <Border x:Name="BookingHistoryPanel" Grid.Column="1" Grid.Row="0" Background="#0B1220" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="8" Padding="10"
                            Visibility="{Binding HasZnunyTicket, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Text="Übertragene Zeiten" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock Text="{Binding TransferredTicketTimeText}" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,8"/>
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="390">
                                <ItemsControl ItemsSource="{Binding TicketTimeBookings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="0,0,0,1" Padding="0,8">
                                                <StackPanel>
                                                    <TextBlock FontWeight="SemiBold">
                                                        <Run Text="{Binding DisplayTime, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding DisplayMinutes, Mode=OneWay}" Foreground="{StaticResource TextBrush}"/>
                                                    <TextBlock Text="{Binding CostCenter, StringFormat=Kostenstelle: {0}}" Foreground="{StaticResource MutedTextBrush}"/>
                                                    <TextBlock Text="{Binding Order, StringFormat=Auftrag: {0}}" Foreground="{StaticResource MutedTextBrush}"/>
                                                    <TextBlock Text="{Binding ShortDescription}" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Visibility="{Binding Note, Converter={StaticResource StringEmptyToVisibilityConverter}}" Margin="0,6,0,0">
                                                        <TextBlock Text="Notiz:" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}"/>
                                                        <TextBlock Text="{Binding Note}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding StatusText, Mode=OneWay}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                                    <Button Content="Buchungsstatus prüfen" HorizontalAlignment="Left" Margin="0,6,0,0"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Visibility="{Binding CanCheckStatus, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                            Command="{Binding DataContext.CheckTicketTimeBookingCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="Erneut buchen" HorizontalAlignment="Left" Margin="0,6,0,0"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Visibility="{Binding CanRetry, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                            Command="{Binding DataContext.RetryTicketTimeBookingCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Planung (Segmente)" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <Border Background="#0B1220" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Neues Segment" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <DatePicker Grid.Column="0"
                                            Style="{StaticResource DarkIconDatePickerStyle}"
                                            CalendarStyle="{StaticResource DarkCalendarStyle}"
                                            SelectedDate="{Binding NewSegmentDate, UpdateSourceTrigger=PropertyChanged}"/>
                                <ComboBox Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource DarkComboBoxStyle}" ItemsSource="{Binding TimeOptions}" SelectedItem="{Binding NewSegmentStartTime, UpdateSourceTrigger=PropertyChanged}"/>
                                <ComboBox Grid.Column="2" Margin="6,0,0,0" Style="{StaticResource DarkComboBoxStyle}" ItemsSource="{Binding TimeOptions}" SelectedItem="{Binding NewSegmentEndTime, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>
                            <TextBlock Text="Kurzbeschreibung" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,2"/>
                            <TextBox Margin="0,0,0,0" Text="{Binding NewSegmentNote, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="{Binding NewSegmentValidationHint}" Foreground="#FCA5A5" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding NewSegmentConflictWarning}" Foreground="#FBBF24" Margin="0,2,0,0"
                                       Visibility="{Binding HasNewSegmentConflict, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <WrapPanel Margin="0,6,0,0">
                                <Button Content="Segment speichern" Width="140" Command="{Binding AddSegmentCommand}" IsEnabled="{Binding CanSaveNewSegment}"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Segments}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#0B1220" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayIndex, StringFormat=Segment {0}}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>
                                            <DatePicker Grid.Column="0"
                                                        Style="{StaticResource DarkIconDatePickerStyle}"
                                                        CalendarStyle="{StaticResource DarkCalendarStyle}"
                                                        SelectedDate="{Binding SegmentDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <ComboBox Grid.Column="1" Margin="6,0,0,0" Style="{StaticResource DarkComboBoxStyle}" ItemsSource="{Binding DataContext.TimeOptions, RelativeSource={RelativeSource AncestorType=ItemsControl}}" SelectedItem="{Binding StartTimeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <ComboBox Grid.Column="2" Margin="6,0,0,0" Style="{StaticResource DarkComboBoxStyle}" ItemsSource="{Binding DataContext.TimeOptions, RelativeSource={RelativeSource AncestorType=ItemsControl}}" SelectedItem="{Binding EndTimeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </Grid>

                                        <TextBlock Text="Kurzbeschreibung" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,2"/>
                                        <TextBox Margin="0,0,0,0" Text="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Text="{Binding PlannedMinutes, StringFormat=Dauer: {0} min}" Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock Text="{Binding OutlookStatus, StringFormat=Outlook Status: {0}}" Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock Text="{Binding ValidationHint}" Foreground="#FCA5A5"/>

                                        <WrapPanel Margin="0,6,0,0">
                                            <Button Content="Speichern" Width="90" Command="{Binding DataContext.SaveSegmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                            <Button Content="Löschen" Width="90" Style="{StaticResource DangerButtonStyle}" Command="{Binding DataContext.DeleteSegmentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                            <Button Content="Outlook Blocker löschen" Width="170" Style="{StaticResource DangerButtonStyle}" Command="{Binding DataContext.DeleteSegmentOutlookCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
