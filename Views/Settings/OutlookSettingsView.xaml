<UserControl x:Class="TaskTool.Views.Settings.OutlookSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,16">
        <StackPanel MaxWidth="1200" HorizontalAlignment="Center" Grid.IsSharedSizeScope="True">
            <TextBlock Text="Outlook" Style="{StaticResource SettingsSectionTitleStyle}"/>
            <TextBlock Text="Kalenderdarstellung, Konflikthinweise und Synchronisation." Style="{StaticResource SettingsSectionDescriptionStyle}"/>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Kalender" Style="{StaticResource SettingsCardTitleStyle}"/>
                        <CheckBox Content="Outlook Sync aktiv" IsChecked="{Binding OutlookSyncEnabled}" Margin="0,0,0,8"/>
                        <CheckBox Content="Outlook Kalender anzeigen" IsChecked="{Binding OutlookCalendarEnabled}" Margin="0,0,0,8"/>
                        <CheckBox Content="Konfliktwarnungen anzeigen" IsChecked="{Binding OutlookConflictWarningsEnabled}" Margin="0,0,0,8"/>
                        <CheckBox Content="Teams-Button anzeigen" IsChecked="{Binding OutlookTeamsButtonEnabled}" Margin="0,0,0,8"/>
                        <CheckBox Content="Ganztagstermine als Tagesmarker interpretieren" IsChecked="{Binding OutlookInterpretAllDayAsMarkers}" Margin="0,0,0,8"/>
                        <CheckBox Content="Wochenende anzeigen" IsChecked="{Binding ShowWeekendInWeekView}" Margin="0,0,0,12"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Synchronisation" Style="{StaticResource SettingsCardTitleStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Kalender-Zeitzone" Style="{StaticResource SettingsLabelStyle}"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" Style="{StaticResource SettingsComboStyle}" ItemsSource="{Binding CalendarTimeZones}" SelectedItem="{Binding CalendarTimeZoneId}"/>
                            <TextBlock Grid.Row="1" Text="Kalender Sync-Modus" Style="{StaticResource SettingsLabelStyle}"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource SettingsComboStyle}" ItemsSource="{Binding OutlookSyncModes}" SelectedItem="{Binding OutlookCalendarSyncMode}"/>
                            <TextBlock Grid.Row="2" Text="Sync-Intervall (Minuten)" Style="{StaticResource SettingsLabelStyle}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding OutlookCalendarSyncIntervalMinutes}" Width="120" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="3" Text="Rückblick (Tage)" Style="{StaticResource SettingsLabelStyle}"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding OutlookCalendarRangePastDays}" Width="120" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="4" Text="Vorschau (Tage)" Style="{StaticResource SettingsLabelStyle}"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding OutlookCalendarRangeFutureDays}" Width="120" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="5" Text="Outlook Kategorie" Style="{StaticResource SettingsLabelStyle}"/>
                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding OutlookCategoryName}" Style="{StaticResource SettingsTextBoxStyle}"/>
                        </Grid>
                        <WrapPanel Margin="0,4,0,0">
                            <Button Content="Jetzt synchronisieren" Width="170" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RefreshOutlookCalendarCommand}"/>
                            <Button Content="Verbindung testen" Width="170" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding TestOutlookConnectionCommand}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
