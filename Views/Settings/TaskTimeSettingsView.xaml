<UserControl x:Class="TaskTool.Views.Settings.TaskTimeSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,16">
        <StackPanel MaxWidth="1200" HorizontalAlignment="Center" Grid.IsSharedSizeScope="True">
            <TextBlock Text="Aufgaben &amp; Zeiten" Style="{StaticResource SettingsSectionTitleStyle}"/>
            <TextBlock Text="Segmentplanung und Sollarbeitszeiten gemeinsam konfigurieren." Style="{StaticResource SettingsSectionDescriptionStyle}"/>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Planung" Style="{StaticResource SettingsCardTitleStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Standarddauer neuer Segmente" Style="{StaticResource SettingsLabelStyle}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                <ComboBox Width="120" Style="{StaticResource DarkComboBoxStyle}" ItemsSource="{Binding SegmentDurationOptions}" SelectedItem="{Binding DefaultSegmentDurationMinutes}"/>
                                <TextBlock Text="Minuten" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Grid>
                        <CheckBox Content="Interne Aufgaben-Segmente zusätzlich im Kalender anzeigen" IsChecked="{Binding ShowInternalTaskSegmentsInCalendar}" Margin="0,0,0,4"/>
                        <TextBlock Text="Bei aktiver Outlook-Synchronisierung können geplante Segmente sonst doppelt erscheinen." Style="{StaticResource SettingsHelpStyle}" Margin="24,0,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Sollstunden / Arbeitszeit" Style="{StaticResource SettingsCardTitleStyle}"/>
                        <TextBlock Text="Sollzeit pro Wochentag in Minuten" Style="{StaticResource SettingsHelpStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Montag" Style="{StaticResource SettingsLabelStyle}"/><TextBox Grid.Row="0" Grid.Column="1" Text="{Binding MondayTargetMinutes}" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="1" Text="Dienstag" Style="{StaticResource SettingsLabelStyle}"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TuesdayTargetMinutes}" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="2" Text="Mittwoch" Style="{StaticResource SettingsLabelStyle}"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding WednesdayTargetMinutes}" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="3" Text="Donnerstag" Style="{StaticResource SettingsLabelStyle}"/><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ThursdayTargetMinutes}" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="4" Text="Freitag" Style="{StaticResource SettingsLabelStyle}"/><TextBox Grid.Row="4" Grid.Column="1" Text="{Binding FridayTargetMinutes}" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="5" Text="Samstag" Style="{StaticResource SettingsLabelStyle}"/><TextBox Grid.Row="5" Grid.Column="1" Text="{Binding SaturdayTargetMinutes}" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="6" Text="Sonntag" Style="{StaticResource SettingsLabelStyle}"/><TextBox Grid.Row="6" Grid.Column="1" Text="{Binding SundayTargetMinutes}" Margin="0,0,0,8"/>
                        </Grid>
                    </StackPanel>
                </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
