<UserControl x:Class="TaskTool.Views.Settings.UpdateSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,16">
        <StackPanel MaxWidth="1200" HorizontalAlignment="Center" Grid.IsSharedSizeScope="True">
            <TextBlock Text="Updates" Style="{StaticResource SettingsSectionTitleStyle}"/>
            <TextBlock Text="Update-Kanal, automatische Prüfung und verfügbare Versionen." Style="{StaticResource SettingsSectionDescriptionStyle}"/>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Updates" Style="{StaticResource SettingsCardTitleStyle}"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="150" MaxWidth="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Installierte Version" TextWrapping="Wrap" Style="{StaticResource SettingsLabelStyle}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding InstalledVersion, Mode=OneWay}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="1" Text="Letzte Prüfung" TextWrapping="Wrap" Style="{StaticResource SettingsLabelStyle}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LastUpdateCheck}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="2" Text="Verfügbare Version" TextWrapping="Wrap" Style="{StaticResource SettingsLabelStyle}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AvailableVersion}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="3" Text="Update-Kanal" TextWrapping="Wrap" Style="{StaticResource SettingsLabelStyle}"/>
                            <ComboBox Grid.Row="3" Grid.Column="1" MinWidth="160" ItemsSource="{Binding UpdateChannels}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding UpdateChannel}" Style="{StaticResource SettingsComboStyle}"/>
                        </Grid>
                        <TextBlock Text="Stable erhält nur Versionen ohne Test-Suffix. Testversionen erhält zusätzlich Alpha-, Beta- und RC-Versionen." Style="{StaticResource SettingsHelpStyle}"/><TextBlock Text="Testversionen können noch Fehler enthalten." Foreground="#FBBF24" Visibility="{Binding IsTestChannel, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,8"/>
                        <CheckBox Content="Beim Start automatisch nach Updates suchen" IsChecked="{Binding CheckForUpdatesOnStartup}" Margin="0,0,0,8"/>
                        <CheckBox Content="Verfügbare Updates beim Start automatisch installieren" IsChecked="{Binding AutoInstallUpdatesOnStartup}" Margin="0,0,0,8"/>
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding UpdateProgress}" Height="8" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding UpdateStatus}" Foreground="#FBBF24" TextWrapping="Wrap"/>
                        <TextBlock Text="Release Notes" FontWeight="SemiBold" Margin="0,10,0,4"/>
                        <TextBox Text="{Binding ReleaseNotes, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="160" VerticalScrollBarVisibility="Auto"/>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="Nach Updates suchen" Width="170" Command="{Binding CheckForUpdatesCommand}"/>
                            <Button Content="Update installieren" Width="170" Command="{Binding InstallUpdateCommand}"/>
                            <Button Content="GitHub öffnen" Width="150" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding OpenReleaseCommand}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
