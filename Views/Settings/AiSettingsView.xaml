<UserControl x:Class="TaskTool.Views.Settings.AiSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,16">
        <StackPanel MaxWidth="1200" HorizontalAlignment="Center">
            <TextBlock Text="KI" Style="{StaticResource SettingsSectionTitleStyle}"/>
            <TextBlock Text="OpenAI-kompatible APIs oder einen lokalen llama.cpp-Server konfigurieren und testen." Style="{StaticResource SettingsSectionDescriptionStyle}"/>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <CheckBox Content="KI verwenden" IsChecked="{Binding AiEnabled}" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <StackPanel IsEnabled="{Binding AiEnabled}">
                        <TextBlock Text="Provider" Style="{StaticResource SettingsLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding AiProviders}" DisplayMemberPath="DisplayName" SelectedValuePath="Value"
                                  SelectedValue="{Binding AiProvider}" Style="{StaticResource SettingsComboStyle}" Margin="0,0,0,12"/>

                        <StackPanel Visibility="{Binding IsOpenAiProvider, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="API Basis-URL" Style="{StaticResource SettingsLabelStyle}"/>
                            <TextBox Text="{Binding AiApiBaseUrl, UpdateSourceTrigger=LostFocus}" Style="{StaticResource SettingsTextBoxStyle}"/>
                            <TextBlock Text="Beispiel: https://api.openai.com/v1 oder http://server:1234/v1" Style="{StaticResource SettingsHelpStyle}"/>
                            <TextBlock Text="API-Key (optional)" Style="{StaticResource SettingsLabelStyle}"/>
                            <TextBox Text="{Binding AiApiKey, UpdateSourceTrigger=LostFocus}" Style="{StaticResource SettingsTextBoxStyle}"/>
                            <TextBlock Text="Der API-Key wird mit Windows DPAPI verschlüsselt gespeichert und nach dem Speichern maskiert angezeigt." Style="{StaticResource SettingsHelpStyle}"/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsLocalAiProvider, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="llama.cpp Serverdatei" Style="{StaticResource SettingsLabelStyle}"/>
                            <TextBox Text="{Binding AiLocalServerExecutablePath, UpdateSourceTrigger=LostFocus}" Style="{StaticResource SettingsTextBoxStyle}"/>
                            <TextBlock Text="Pfad zu llama-server.exe." Style="{StaticResource SettingsHelpStyle}"/>
                            <TextBlock Text="GGUF-Modelldatei" Style="{StaticResource SettingsLabelStyle}"/>
                            <TextBox Text="{Binding AiLocalModelPath, UpdateSourceTrigger=LostFocus}" Style="{StaticResource SettingsTextBoxStyle}"/>
                            <TextBlock Text="Modell-Download-URL" Style="{StaticResource SettingsLabelStyle}"/>
                            <TextBox Text="{Binding AiLocalModelDownloadUrl, UpdateSourceTrigger=LostFocus}" Style="{StaticResource SettingsTextBoxStyle}"/>
                            <TextBlock Text="Port" Style="{StaticResource SettingsLabelStyle}"/>
                            <TextBox Text="{Binding AiLocalServerPort, UpdateSourceTrigger=LostFocus}" Style="{StaticResource SettingsTextBoxStyle}" Width="140" HorizontalAlignment="Left"/>
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding AiDownloadProgress}" Height="8" Margin="0,8,0,6"/>
                            <TextBlock Text="{Binding AiLocalServerStatus}" Style="{StaticResource SettingsHelpStyle}"/>
                            <WrapPanel>
                                <Button Content="Modell herunterladen" Command="{Binding DownloadAiModelCommand}"/>
                                <Button Content="Server starten" Command="{Binding StartLocalAiCommand}"/>
                                <Button Content="Server stoppen" Command="{Binding StopLocalAiCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                            </WrapPanel>
                        </StackPanel>

                        <TextBlock Text="Modell" Style="{StaticResource SettingsLabelStyle}"/>
                        <TextBox Text="{Binding AiModel, UpdateSourceTrigger=LostFocus}" Style="{StaticResource SettingsTextBoxStyle}"/>
                        <TextBlock Text="Freier Modellname, den der konfigurierte Server erwartet." Style="{StaticResource SettingsHelpStyle}"/>
                        <Button Content="Verbindung testen" Command="{Binding TestAiCommand}" Width="170" HorizontalAlignment="Left" Margin="0,8,0,8"/>
                        <TextBlock Text="{Binding AiStatus}" TextWrapping="Wrap" Foreground="#FBBF24" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
