<UserControl x:Class="TaskTool.Views.Settings.HomeOfficeSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,16">
        <StackPanel MaxWidth="1200" HorizontalAlignment="Center" Grid.IsSharedSizeScope="True">
            <TextBlock Text="Homeoffice" Style="{StaticResource SettingsSectionTitleStyle}"/>
            <TextBlock Text="Empfänger und Verhalten der Homeoffice-Kommunikation." Style="{StaticResource SettingsSectionDescriptionStyle}"/>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Homeoffice" Style="{StaticResource SettingsCardTitleStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="E-Mail Empfänger 1" Style="{StaticResource SettingsLabelStyle}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding HomeOfficeMailRecipient1, UpdateSourceTrigger=LostFocus}" Style="{StaticResource SettingsTextBoxStyle}"/>
                            <TextBlock Grid.Row="1" Text="E-Mail Empfänger 2" Style="{StaticResource SettingsLabelStyle}"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" MaxWidth="360" HorizontalAlignment="Stretch">
                                <TextBox Text="{Binding HomeOfficeMailRecipient2, UpdateSourceTrigger=LostFocus}" Style="{StaticResource SettingsTextBoxStyle}"/>
                                <TextBlock Text="Optional" Style="{StaticResource SettingsHelpStyle}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
