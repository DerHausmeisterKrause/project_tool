<UserControl x:Class="TaskTool.Views.Settings.TicketSystemSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,16">
        <StackPanel MaxWidth="1200" HorizontalAlignment="Center" Grid.IsSharedSizeScope="True">
            <TextBlock Text="Ticketsystem" Style="{StaticResource SettingsSectionTitleStyle}"/>
            <TextBlock Text="Verbindung, Synchronisation und Funktionen der Znuny-/OTRS-Integration." Style="{StaticResource SettingsSectionDescriptionStyle}"/>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Znuny / OTRS – Verbindung" Style="{StaticResource SettingsCardTitleStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Server / Web URL" Style="{StaticResource SettingsLabelStyle}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TicketSystemWebUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsLongTextBoxStyle}" ToolTip="Beispiel: https://SERVER/index.pl"/>
                            <TextBlock Grid.Row="1" Text="API URL" Style="{StaticResource SettingsLabelStyle}"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" MaxWidth="560" HorizontalAlignment="Stretch">
                                <TextBox Text="{Binding TicketSystemApiUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsLongTextBoxStyle}"/>
                                <TextBlock Text="Beispiel: https://SERVER/nph-genericinterface.pl/Webservice/GenericTicketConnectorREST" Style="{StaticResource SettingsHelpStyle}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="2" Text="Benutzername" Style="{StaticResource SettingsLabelStyle}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding TicketSystemUsername, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBoxStyle}"/>
                            <TextBlock Grid.Row="3" Text="Passwort" Style="{StaticResource SettingsLabelStyle}"/>
                            <TextBox x:Name="TicketSystemPasswordTextBox" Grid.Row="3" Grid.Column="1"
                                     Text="{Binding TicketSystemPassword, UpdateSourceTrigger=LostFocus}" Style="{StaticResource SettingsTextBoxStyle}"
                                     GotKeyboardFocus="TicketSystemPasswordTextBox_GotKeyboardFocus"
                                     PreviewMouseLeftButtonDown="TicketSystemPasswordTextBox_PreviewMouseLeftButtonDown"
                                     LostKeyboardFocus="TicketSystemPasswordTextBox_LostKeyboardFocus"
                                     ToolTip="Verschlüsselt gespeichert. Beim Bearbeiten sichtbar; nach dem Speichern maskiert."/>
                            <TextBlock Grid.Row="4" Text="Agenten-ID" Style="{StaticResource SettingsLabelStyle}"/>
                            <StackPanel Grid.Row="4" Grid.Column="1">
                                <TextBox Text="{Binding TicketSystemAgentId, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                <TextBlock Text="Interne numerische Agenten-ID für Owner und Responsible." Style="{StaticResource SettingsHelpStyle}"/>
                            </StackPanel>
                        </Grid>
                        <WrapPanel Margin="0,4,0,0">
                            <Button Content="Verbindung testen" Width="170" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding TestTicketSystemConnectionCommand}"/>
                            <Button Content="API-Routen testen" Width="170" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding TestTicketSystemRoutesCommand}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- 8. Znuny synchronization -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Znuny / OTRS – Synchronisierung" Style="{StaticResource SettingsCardTitleStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="TicketSearch Route" Style="{StaticResource SettingsLabelStyle}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TicketSystemTicketSearchRoute, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBoxStyle}"/>
                            <TextBlock Grid.Row="1" Text="TicketSearch HTTP-Methode" Style="{StaticResource SettingsLabelStyle}"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource SettingsComboStyle}" ItemsSource="{Binding TicketSystemSearchMethods}" SelectedItem="{Binding TicketSystemTicketSearchMethod}"/>
                            <TextBlock Grid.Row="2" Text="TicketSearch Authentifizierung" Style="{StaticResource SettingsLabelStyle}"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" Style="{StaticResource SettingsComboStyle}" ItemsSource="{Binding TicketSystemAuthModes}" SelectedItem="{Binding TicketSystemTicketSearchAuthMode}"/>
                            <TextBlock Grid.Row="3" Text="TicketGet Route" Style="{StaticResource SettingsLabelStyle}"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding TicketSystemTicketGetRouteTemplate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBoxStyle}"/>
                            <TextBlock Grid.Row="4" Text="TicketGet HTTP-Methode" Style="{StaticResource SettingsLabelStyle}"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding TicketSystemTicketGetMethod}" Width="120" HorizontalAlignment="Left" IsReadOnly="True" Margin="0,0,0,8"/>
                            <TextBlock Grid.Row="5" Text="TicketGet Authentifizierung" Style="{StaticResource SettingsLabelStyle}"/>
                            <ComboBox Grid.Row="5" Grid.Column="1" Style="{StaticResource SettingsComboStyle}" ItemsSource="{Binding TicketSystemTicketGetAuthModes}" SelectedItem="{Binding TicketSystemTicketGetAuthMode}"/>
                            <TextBlock Grid.Row="6" Text="TicketUpdate Route" Style="{StaticResource SettingsLabelStyle}"/>
                            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding TicketSystemTicketUpdateRoute, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsLongTextBoxStyle}" ToolTip="Standard: /Ticket/{TicketID}/Update"/>
                            <TextBlock Grid.Row="7" Text="Sync-Intervall (Minuten)" Style="{StaticResource SettingsLabelStyle}"/>
                            <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding TicketSystemSyncIntervalMinutes, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                        </Grid>
                        <CheckBox Content="Nur offene Tickets synchronisieren" IsChecked="{Binding TicketSystemOnlyOpenTickets}" Margin="0,4,0,4"/>
                        <CheckBox Content="Geschlossene Tickets anzeigen / übernehmen" IsChecked="{Binding TicketSystemShowClosedTickets}" Margin="0,0,0,4"/>
                        <CheckBox Content="Tickets berücksichtigen, bei denen ich Owner bin" IsChecked="{Binding TicketSystemIncludeOwner}" Margin="0,0,0,4"/>
                        <CheckBox Content="Tickets berücksichtigen, bei denen ich Responsible bin" IsChecked="{Binding TicketSystemIncludeResponsible}" Margin="0,0,0,4"/>
                        <CheckBox Content="Bei neu zugewiesenen Tickets benachrichtigen" IsChecked="{Binding NotifyOnNewAssignedTickets}" Margin="0,0,0,8"/>
                        <CheckBox Content="Anmeldedaten im Ticketsystem automatisch ausfüllen" IsChecked="{Binding TicketSystemAutofillCredentials}" Margin="0,0,0,4"/>
                        <CheckBox Content="Automatisch anmelden" IsChecked="{Binding TicketSystemAutoLogin}" Margin="0,0,0,8"/>
                        <TextBlock Text="Autofill wird ausschließlich auf der konfigurierten HTTPS-Domain ausgeführt. Das Passwort bleibt verschlüsselt und wird nicht protokolliert." Style="{StaticResource SettingsHelpStyle}"/>

                        <TextBlock Text="Neue Aufgaben / Ticket-Vorschläge" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Candidate Benutzer" Style="{StaticResource SettingsLabelStyle}"/>
                            <StackPanel Grid.Row="0" Grid.Column="1">
                                <TextBox Text="{Binding TicketSystemCandidateUserId, UpdateSourceTrigger=LostFocus}" Width="120" HorizontalAlignment="Left" Margin="0,0,0,4"/>
                                <TextBlock Text="Standard: OTRS, Admin (UserID 1). Besitzer UND Verantwortlicher müssen diesem Benutzer entsprechen." Style="{StaticResource SettingsHelpStyle}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="Schlüsselwörter" Style="{StaticResource SettingsLabelStyle}" VerticalAlignment="Top"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" MaxWidth="560" HorizontalAlignment="Stretch">
                                <TextBox Text="{Binding TicketSystemCandidateKeywords, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" Height="90" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Style="{StaticResource SettingsLongTextBoxStyle}"/>
                                <TextBlock Text="Zeile, Komma oder Semikolon als Trennzeichen." Style="{StaticResource SettingsHelpStyle}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="2" Text="Ausschlusswörter" Style="{StaticResource SettingsLabelStyle}" VerticalAlignment="Top"/>
                            <StackPanel Grid.Row="2" Grid.Column="1" MaxWidth="560" HorizontalAlignment="Stretch">
                                <TextBox Text="{Binding TicketSystemCandidateExcludeKeywords, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" Height="90" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Style="{StaticResource SettingsLongTextBoxStyle}"/>
                                <TextBlock Text="Sobald eines dieser Wörter im Titel oder in einer Ticket-Nachricht vorkommt, wird das Ticket ausgeschlossen – auch wenn ein Suchwort gefunden wurde. Zeile, Komma oder Semikolon als Trennzeichen." TextWrapping="Wrap" Style="{StaticResource SettingsHelpStyle}"/>
                            </StackPanel>
                        </Grid>
                        <Button Content="Tickets jetzt synchronisieren" Width="200" HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding ImportTicketSystemTasksCommand}"/>
                        <TextBlock Text="{Binding TicketSystemStatus}" Foreground="#FBBF24" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 9. Ticket creation -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Znuny / OTRS – Ticket-Erstellung" Style="{StaticResource SettingsCardTitleStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="TicketCreate Route" Style="{StaticResource SettingsLabelStyle}"/>
                            <StackPanel Grid.Row="0" Grid.Column="1" MaxWidth="360" HorizontalAlignment="Stretch">
                                <TextBox Text="{Binding TicketSystemTicketCreateRoute, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBoxStyle}" ToolTip="Standard: /TicketCreate"/>
                                <TextBlock Text="Standardroute: /TicketCreate" Style="{StaticResource SettingsHelpStyle}"/>
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="HTTP-Methode" Style="{StaticResource SettingsLabelStyle}"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource SettingsComboStyle}" ItemsSource="{Binding TicketSystemSearchMethods}" SelectedItem="{Binding TicketSystemTicketCreateMethod}"/>
                            <TextBlock Grid.Row="2" Text="Standard Queue" Style="{StaticResource SettingsLabelStyle}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding TicketSystemCreateQueue, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBoxStyle}"/>
                            <TextBlock Grid.Row="3" Text="Standard Status" Style="{StaticResource SettingsLabelStyle}"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding TicketSystemCreateState, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBoxStyle}" ToolTip="Standard: open"/>
                            <TextBlock Grid.Row="4" Text="Standard Priorität" Style="{StaticResource SettingsLabelStyle}"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding TicketSystemCreatePriority, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBoxStyle}" ToolTip="Standard: 3 normal"/>
                            <TextBlock Grid.Row="5" Text="Standard Typ" Style="{StaticResource SettingsLabelStyle}"/>
                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding TicketSystemCreateType, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBoxStyle}"/>
                            <TextBlock Grid.Row="6" Text="Standard CustomerUser" Style="{StaticResource SettingsLabelStyle}" VerticalAlignment="Top"/>
                            <StackPanel Grid.Row="6" Grid.Column="1" MaxWidth="360" HorizontalAlignment="Stretch">
                                <TextBox Text="{Binding TicketSystemCreateCustomerUser, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBoxStyle}"/>
                                <TextBlock Text="Beispiel: m.mustermann" Style="{StaticResource SettingsHelpStyle}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="Neu erstellte Tickets werden dem konfigurierten Agenten als Besitzer und Verantwortlicher zugeordnet. Der CustomerUser wird nicht automatisch vorbelegt."
                                   Style="{StaticResource SettingsHelpStyle}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 10. Ticket replies -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Znuny / OTRS – Antworten" Style="{StaticResource SettingsCardTitleStyle}"/>
                        <TextBlock Text="Antwortvorlage" Style="{StaticResource SettingsLabelStyle}"/>
                        <TextBox Text="{Binding TicketSystemReplyTemplate, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 MinHeight="140"
                                 MaxHeight="260"
                                 MaxLength="10000"
                                 MaxWidth="560"
                                 HorizontalAlignment="Stretch"
                                 ToolTip="Variablen werden beim Klick auf „Antworten“ automatisch ersetzt."
                                 Margin="0,0,0,8"/>
                        <TextBlock Text="Diese Vorlage wird beim Klick auf „Antworten“ eingefügt. Der Text kann vor jedem Versand frei angepasst werden. Leer lassen, wenn Antworten weiterhin mit einem leeren Textfeld beginnen sollen."
                                   Style="{StaticResource SettingsHelpStyle}"/>
                        <TextBlock Text="Verfügbare Variablen:&#10;$Customer – Vor- und Nachname des Ticket-Erstellers&#10;$CustomerFirstName – Vorname&#10;$CustomerLastName – Nachname&#10;$TicketNumber – Ticketnummer&#10;$TicketTitle – Ticketbetreff&#10;$Date – aktuelles Datum"
                                   Style="{StaticResource SettingsHelpStyle}"/>
                        <TextBlock Text="Beispiel:&#10;Hallo $Customer,&#10;&#10;vielen Dank für Ihre Nachricht zu Ticket $TicketNumber."
                                   Style="{StaticResource SettingsHelpStyle}"/>
                    </StackPanel>
                </Border>

                <!-- 11. Dynamic fields -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Znuny / OTRS – Zeitbuchung &amp; Dynamic Fields" Style="{StaticResource SettingsCardTitleStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="DynamicField-Options Route" Style="{StaticResource SettingsLabelStyle}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TicketSystemDynamicFieldOptionsRoute, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsLongTextBoxStyle}" ToolTip="/Ticket/DynamicField/{FieldName}/Options"/>
                            <TextBlock Grid.Row="1" Text="Kostenstelle – Feldname" Style="{StaticResource SettingsLabelStyle}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TicketSystemCostCenterFieldName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBoxStyle}"/>
                            <TextBlock Grid.Row="2" Text="Kostenstellen-Optionen" Style="{StaticResource SettingsLabelStyle}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding TicketSystemCostCenterOptions, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsLongTextBoxStyle}" ToolTip="Beispiel: 4711=Kostenstelle 4711;815=Kostenstelle 815"/>
                            <TextBlock Grid.Row="3" Text="Auftrag – Feldname" Style="{StaticResource SettingsLabelStyle}"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding TicketSystemOrderFieldName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsTextBoxStyle}"/>
                            <TextBlock Grid.Row="4" Text="Auftrags-Optionen" Style="{StaticResource SettingsLabelStyle}"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding TicketSystemOrderOptions, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SettingsLongTextBoxStyle}" ToolTip="Beispiel: 123456=Auftrag 123456"/>
                        </Grid>
                        <TextBlock Text="TicketGet liefert aktuelle DynamicField-Werte, üblicherweise aber keine vollständigen Optionslisten. Deshalb werden die konfigurierten Key-/Anzeigetext-Listen verwendet."
                                   Style="{StaticResource SettingsHelpStyle}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
