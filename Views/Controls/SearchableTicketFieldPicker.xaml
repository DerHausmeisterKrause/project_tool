<UserControl x:Class="TaskTool.Views.Controls.SearchableTicketFieldPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="32">
    <Grid>
        <Button x:Name="OpenButton"
                Style="{StaticResource SecondaryButtonStyle}"
                HorizontalContentAlignment="Stretch"
                Click="OpenButton_Click">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Right" Text="▼" Margin="8,0,0,0"/>
                <TextBlock x:Name="SelectionText" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Button>
        <Popup x:Name="PickerPopup"
               Placement="Bottom"
               PlacementTarget="{Binding ElementName=OpenButton}"
               StaysOpen="False"
               AllowsTransparency="True"
               Closed="PickerPopup_Closed">
            <Border Width="{Binding ActualWidth, ElementName=OpenButton}"
                    MinWidth="240" MaxHeight="360" Padding="6"
                    Background="{StaticResource SurfaceAltBrush}"
                    BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="6">
                <DockPanel>
                    <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="0,0,0,6"
                             TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                    <ListBox x:Name="ResultsList" Background="Transparent" BorderThickness="0"
                             DisplayMemberPath="DisplayText"
                             MouseLeftButtonUp="ResultsList_MouseLeftButtonUp"
                             PreviewKeyDown="ResultsList_PreviewKeyDown"/>
                </DockPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
