<UserControl x:Class="TaskTool.Views.TodayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="TaskFilterSegmentBaseStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="16,5"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="TaskFilterLeftSegmentStyle" TargetType="RadioButton" BasedOn="{StaticResource TaskFilterSegmentBaseStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="RootBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="10,0,0,10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#172033"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TaskFilterMiddleSegmentStyle" TargetType="RadioButton" BasedOn="{StaticResource TaskFilterSegmentBaseStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="RootBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0,1,1,1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#172033"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TaskFilterRightSegmentStyle" TargetType="RadioButton" BasedOn="{StaticResource TaskFilterSegmentBaseStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="RootBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="0,1,1,1" CornerRadius="0,10,10,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#172033"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Background="{StaticResource BgBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock Text="Neue Aufgabe" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="QuickAddTextBox" Grid.Column="0" Text="{Binding QuickAddText, UpdateSourceTrigger=PropertyChanged}" FontSize="16" Padding="14,10" Margin="0"/>
                    <Button Grid.Column="1" Content="＋" Width="44" Height="44" FontSize="22" Padding="0" Command="{Binding QuickAddCommand}"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}">
            <Grid x:Name="WorkDayHeaderGrid" SizeChanged="WorkDayHeaderGrid_SizeChanged">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="WorkDayStatisticsPanel" Grid.Row="0" Grid.Column="0" Margin="0,0,24,0">
                    <TextBlock Text="Arbeitstag heute" FontSize="18" FontWeight="SemiBold"/>
                    <StackPanel Margin="0,4,0,0">
                        <TextBlock Foreground="{StaticResource MutedTextBrush}">
                            <Run Text="Ticket-/Aufgabenzeit heute: "/>
                            <Run Text="{Binding TicketMinutesToday, StringFormat={}{0:N0} Min.}" FontWeight="SemiBold"/>
                        </TextBlock>
                        <TextBlock Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0">
                            <Run Text="Ticket-/Aufgabenzeit Monat: "/>
                            <Run Text="{Binding TicketMinutesCurrentMonth, StringFormat={}{0:N0} Min.}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="WorkDayMarkerPanel" Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="Transparent" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="16" Padding="0" Margin="0,0,0,8" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="TodayDayType" Content="Normal" Style="{StaticResource DayMarkerSegmentLeftStyle}"
                                         IsChecked="{Binding DayType, Converter={StaticResource EqualityConverter}, ConverterParameter=Normal}" Command="{Binding SetDayTypeNormalCommand}"/>
                            <RadioButton GroupName="TodayDayType" Content="UL" Style="{StaticResource DayMarkerSegmentMiddleStyle}"
                                         IsChecked="{Binding DayType, Converter={StaticResource EqualityConverter}, ConverterParameter=UL}" Command="{Binding SetDayTypeUlCommand}"/>
                            <RadioButton GroupName="TodayDayType" Content="AM" Style="{StaticResource DayMarkerSegmentRightStyle}"
                                         IsChecked="{Binding DayType, Converter={StaticResource EqualityConverter}, ConverterParameter=AM}" Command="{Binding SetDayTypeAmCommand}"/>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                        <ToggleButton Content="HO" Style="{StaticResource DayMarkerChipToggleStyle}" IsChecked="{Binding IsHo, Mode=OneWay}" Command="{Binding ToggleHomeOfficeCommand}"/>
                        <ToggleButton Content="BR" Style="{StaticResource DayMarkerChipToggleStyle}" IsChecked="{Binding IsBr}" Command="{Binding SaveMarkersCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="#FCA5A5" TextWrapping="Wrap" Margin="4,0,0,8"/>

        <Border Grid.Row="3" Style="{StaticResource CardStyle}">
            <Grid Margin="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Margin="0,0,0,8" HorizontalAlignment="Left" Background="Transparent">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="TaskScope" Content="Heute" MinWidth="90" Style="{StaticResource TaskFilterLeftSegmentStyle}"
                                     IsChecked="{Binding SelectedTaskScope, Converter={StaticResource EqualityConverter}, ConverterParameter=Today}" Command="{Binding ShowTodayTasksCommand}"/>
                        <RadioButton GroupName="TaskScope" Content="Aktuelle Aufgaben" MinWidth="165" Style="{StaticResource TaskFilterMiddleSegmentStyle}"
                                     IsChecked="{Binding SelectedTaskScope, Converter={StaticResource EqualityConverter}, ConverterParameter=Current}" Command="{Binding ShowCurrentTasksCommand}"/>
                        <RadioButton GroupName="TaskScope" Content="{Binding CandidateTabTitle}" MinWidth="165" Style="{StaticResource TaskFilterMiddleSegmentStyle}"
                                     IsChecked="{Binding SelectedTaskScope, Converter={StaticResource EqualityConverter}, ConverterParameter=CandidateTickets}" Command="{Binding ShowNewTasksCommand}"/>
                        <RadioButton GroupName="TaskScope" Content="Erledigte Aufgaben" MinWidth="165" Style="{StaticResource TaskFilterRightSegmentStyle}"
                                     IsChecked="{Binding SelectedTaskScope, Converter={StaticResource EqualityConverter}, ConverterParameter=Completed}" Command="{Binding ShowCompletedTasksCommand}"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" Visibility="{Binding ShowActiveTaskList, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ActiveTaskListHeading}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    Visibility="{Binding ShowCurrentTaskList, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Sortieren nach:" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Width="155" Style="{StaticResource DarkComboBoxStyle}"
                                      ItemsSource="{Binding CurrentTaskSortFields}"
                                      SelectedItem="{Binding SelectedCurrentTaskSortField}"/>
                            <ComboBox Width="135" Margin="6,0,0,0" Style="{StaticResource DarkComboBoxStyle}"
                                      ItemsSource="{Binding CurrentTaskSortDirections}"
                                      SelectedItem="{Binding SelectedCurrentTaskSortDirection}"/>
                        </StackPanel>
                    </Grid>
                    <TextBox Grid.Row="1" Text="{Binding TaskSearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                </Grid>

                <TextBox Grid.Row="1" Text="{Binding CompletedTaskSearchText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"
                         Visibility="{Binding ShowCompletedTaskList, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <Grid Grid.Row="1" Visibility="{Binding ShowCandidateTickets, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Neue Aufgaben:" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Aktualisieren" Width="120" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RefreshCandidateTicketsCommand}"/>
                </Grid>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Background="Transparent"
                              Visibility="{Binding ShowTodayAgenda, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl x:Name="TodayAgendaItems" ItemsSource="{Binding TodayAgendaItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,9" Margin="0,0,0,8">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsOutlook}" Value="True">
                                                    <Setter Property="Background" Value="#173126"/>
                                                    <Setter Property="BorderBrush" Value="#4ADE80"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <Border HorizontalAlignment="Left" Padding="7,2" CornerRadius="8">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#1D4ED8"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOutlook}" Value="True">
                                                                <Setter Property="Background" Value="#15803D"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding TypeLabel}" FontSize="10" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                            </Border>
                                            <TextBlock Text="{Binding TimeLabel}" Margin="0,5,8,0" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,12,0">
                                            <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Location}" Margin="0,3,0,0" FontSize="11" Foreground="{StaticResource MutedTextBrush}"
                                                       TextTrimming="CharacterEllipsis" Visibility="{Binding Location, Converter={StaticResource StringEmptyToVisibilityConverter}}"/>
                                            <WrapPanel Margin="0,4,0,0" Visibility="{Binding IsTask, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Border Style="{StaticResource BadgeStyle}"><TextBlock Text="{Binding Task.Status}"/></Border>
                                                <TextBlock VerticalAlignment="Center" Text="{Binding Task.TicketMinutesBooked, StringFormat=Ticket: {0} min}"/>
                                                <Button Content="Ticket öffnen" Style="{StaticResource LinkButtonStyle}"
                                                        Visibility="{Binding Task.TicketUrl, Converter={StaticResource StringEmptyToVisibilityConverter}}"
                                                        Command="{Binding DataContext.OpenTicketUrlCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding Task.TicketUrl}"/>
                                            </WrapPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                                    Visibility="{Binding IsTask, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Button Content="▶" Width="36" Height="36" Padding="0" Command="{Binding DataContext.StartTaskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Task}"/>
                                            <Button Content="■" Width="36" Height="36" Padding="0" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding DataContext.StopTaskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Task}"/>
                                            <Button Content="✓" Width="36" Height="36" Padding="0" Style="{StaticResource SuccessButtonStyle}" Command="{Binding DataContext.DoneTaskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Task}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                                    Visibility="{Binding IsOutlook, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Button Content="In Outlook öffnen" Width="130" Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding DataContext.OpenAgendaOutlookEventCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding OutlookEvent}"/>
                                            <Button Content="Teams öffnen" Width="105" Style="{StaticResource SecondaryButtonStyle}"
                                                    Visibility="{Binding HasTeamsLink, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Command="{Binding DataContext.OpenAgendaTeamsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding OutlookEvent.OnlineMeetingJoinUrl}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border.InputBindings>
                                        <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.SelectTaskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Task}"/>
                                    </Border.InputBindings>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Background="Transparent"
                              Visibility="{Binding ShowCurrentTaskList, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl x:Name="CurrentTasksItems" ItemsSource="{Binding DisplayedTasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border>
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Running"><Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter Property="BorderThickness" Value="2"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Done"><Setter Property="Opacity" Value="0.58"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
                                            <TextBlock Margin="0,4,0,6" Foreground="{StaticResource MutedTextBrush}" Text="{Binding StartLocal, StringFormat=Start: {0:dd.MM HH:mm}}"/>
                                            <WrapPanel>
                                                <Border Visibility="{Binding ShowCurrentListBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource BadgeStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrentListBadgePlanned}" Value="True">
                                                                    <Setter Property="Background" Value="#1D4ED8"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding CurrentListBadgeText}" Foreground="#DBEAFE"/>
                                                </Border>
                                                <TextBlock VerticalAlignment="Center" Text="{Binding TicketMinutesBooked, StringFormat=Ticket: {0} min}"/>
                                            </WrapPanel>
                                            <Button Content="Ticket öffnen" Style="{StaticResource LinkButtonStyle}"
                                                    Visibility="{Binding TicketUrl, Converter={StaticResource StringEmptyToVisibilityConverter}}"
                                                    ToolTip="{Binding TicketUrl}"
                                                    Command="{Binding DataContext.OpenTicketUrlCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding TicketUrl}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Width="36" Height="36" Padding="0" FontSize="16"
                                                    Command="{Binding DataContext.TogglePinTaskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                        <Setter Property="Content" Value="📌"/>
                                                        <Setter Property="Opacity" Value="0.45"/>
                                                        <Setter Property="ToolTip" Value="Aufgabe anpinnen"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                <Setter Property="Opacity" Value="1"/>
                                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                                <Setter Property="ToolTip" Value="Anheftung lösen"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="▶" Width="36" Height="36" Padding="0" Command="{Binding DataContext.StartTaskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                            <Button Content="■" Width="36" Height="36" Padding="0" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding DataContext.StopTaskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                            <Button Content="✓" Width="36" Height="36" Padding="0" Style="{StaticResource SuccessButtonStyle}" Command="{Binding DataContext.DoneTaskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border.InputBindings><MouseBinding Gesture="LeftClick" Command="{Binding DataContext.SelectTaskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/></Border.InputBindings>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Background="Transparent"
                              Visibility="{Binding ShowCompletedTaskList, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl x:Name="CompletedTasksItems" ItemsSource="{Binding CompletedTasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardStyle}" Opacity="0.7">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" Text="{Binding TicketMinutesBooked, StringFormat=Gebucht: {0} min}"/>
                                        <Button Content="Ticket öffnen" Style="{StaticResource LinkButtonStyle}"
                                                Visibility="{Binding TicketUrl, Converter={StaticResource StringEmptyToVisibilityConverter}}"
                                                ToolTip="{Binding TicketUrl}"
                                                Command="{Binding DataContext.OpenTicketUrlCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding TicketUrl}"/>
                                    </StackPanel>
                                    <Border.InputBindings><MouseBinding Gesture="LeftClick" Command="{Binding DataContext.SelectTaskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/></Border.InputBindings>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Background="Transparent"
                              Visibility="{Binding ShowCandidateTickets, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{Binding CandidateStatus}" Foreground="{StaticResource AccentBrush}" Margin="4,8"
                                   Visibility="{Binding ShowCandidateStatus, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding CandidateHint}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="4,8"
                                   Visibility="{Binding ShowCandidateHint, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <ItemsControl ItemsSource="{Binding NewTaskCandidates}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,16,0">
                                                <TextBlock Text="{Binding TicketNumber}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" Margin="0,3,0,5"/>
                                                <TextBlock Text="{Binding DescriptionPreview}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" MaxHeight="64"/>
                                                <WrapPanel Margin="0,8,0,0">
                                                    <TextBlock Text="Besitzer: " FontWeight="SemiBold"/><TextBlock Text="{Binding Owner}" Margin="0,0,16,0"/>
                                                    <TextBlock Text="Verantwortlicher: " FontWeight="SemiBold"/><TextBlock Text="{Binding Responsible}"/>
                                                </WrapPanel>
                                                <TextBlock Text="{Binding MatchedKeyword, StringFormat=Treffer: {0}}" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Ticket öffnen" Width="125" VerticalAlignment="Center" Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding DataContext.OpenTicketUrlCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding WebUrl}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
