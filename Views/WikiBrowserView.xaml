<UserControl x:Class="TaskTool.Views.WikiBrowserView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" Background="{StaticResource BgBrush}">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="Wiki" FontSize="24" FontWeight="SemiBold"/><WrapPanel Margin="0,8,0,0"><TextBlock Text="Wiki:" VerticalAlignment="Center" Margin="0,0,8,8"/><ComboBox Width="260" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" DisplayMemberPath="Name"/><Button Content="Home" Command="{Binding HomeCommand}"/><Button Content="Zurück" Command="{Binding BackCommand}"/><Button Content="Vor" Command="{Binding ForwardCommand}"/><Button Content="Neu laden" Command="{Binding ReloadCommand}"/></WrapPanel><TextBlock x:Name="BrowserStatus" Foreground="#FBBF24" TextWrapping="Wrap"/></StackPanel></Border>
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0"><wv2:WebView2 x:Name="WikiBrowser" DefaultBackgroundColor="#111827"/></Border>
    </Grid>
</UserControl>
