<UserControl x:Class="TaskTool.Views.AiChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:TaskTool.Models"
             xmlns:controls="clr-namespace:TaskTool.Views.Controls">
    <Grid Margin="8" MinHeight="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="KI" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="{Binding ProviderDescription, StringFormat=Aktiver Provider: {0}}" Foreground="{StaticResource MutedTextBrush}"/>
            <TextBlock Text="{Binding AvailabilityMessage}" Foreground="#FBBF24" TextWrapping="Wrap" Margin="0,5,0,0"/>
            <Button Content="KI-Einstellungen öffnen" Command="{Binding OpenAiSettingsCommand}" HorizontalAlignment="Left" Margin="0,8,0,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDisabled}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <Border Grid.Row="2" MinHeight="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushColor}"
                BorderThickness="1" CornerRadius="12" Padding="12">
            <Grid MinHeight="0">
                <TextBlock Text="Stelle der Plenaro KI eine Frage." Foreground="{StaticResource MutedTextBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasMessages}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ScrollViewer x:Name="MessageScrollViewer" MinHeight="0" Background="Transparent"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              HorizontalContentAlignment="Stretch"
                              PreviewMouseWheel="MessageScrollViewer_OnPreviewMouseWheel">
                    <ItemsControl ItemsSource="{Binding Messages}" HorizontalContentAlignment="Stretch"
                                  MaxWidth="1250">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                <Setter Property="Margin" Value="0,0,0,10"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:AiChatMessage}">
                                <Border x:Name="Bubble" Background="#172554" CornerRadius="10" Padding="12"
                                        MaxWidth="1050" HorizontalAlignment="Left">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Author}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="#93C5FD" Margin="0,0,0,3"/>
                                        <TextBlock x:Name="UserContent" Text="{Binding Content}" TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextBrush}"/>
                                        <controls:MarkdownMessageView x:Name="AssistantContent" Markdown="{Binding Content}" Foreground="{StaticResource TextBrush}" Visibility="Visible"/>
                                        <StackPanel x:Name="KnowledgeSources" Margin="0,5,0,0"
                                                    ToolTip="{Binding KnowledgeSummary}" Visibility="Collapsed">
                                            <TextBlock Text="{Binding KnowledgeHeading}" Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="11" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding KnowledgePaths}" Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="11" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                       MaxHeight="30"/>
                                        </StackPanel>
                                        <Button Content="Kopieren" Command="{Binding DataContext.CopyMessageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" HorizontalAlignment="Right"
                                                Padding="8,2" Height="26" Margin="0,7,0,0">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource LinkButtonStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    <Setter Property="Padding" Value="8,2"/>
                                                    <Setter Property="Height" Value="26"/>
                                                    <Setter Property="Margin" Value="0,7,0,0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAssistant}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                        <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right"/>
                                        <Setter TargetName="Bubble" Property="Background" Value="#1F2937"/>
                                        <Setter TargetName="Bubble" Property="MaxWidth" Value="780"/>
                                        <Setter TargetName="AssistantContent" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsAssistant}" Value="True">
                                        <Setter TargetName="UserContent" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasKnowledgeSources}" Value="True">
                                        <Setter TargetName="KnowledgeSources" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <TextBox x:Name="InputTextBox" Grid.Row="3" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="180"
                 VerticalScrollBarVisibility="Auto" Padding="12" Margin="0,12,0,8"
                 KeyDown="InputTextBox_OnKeyDown" IsEnabled="{Binding IsEnabled}" ToolTip="Nachricht eingeben …"/>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding SendingStatus}" Foreground="{StaticResource MutedTextBrush}"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#F87171" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Chat leeren" Command="{Binding ClearCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                <Button Content="Senden" Command="{Binding SendCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
